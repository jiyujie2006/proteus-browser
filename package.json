{
  "name": "proteus",
  "version": "0.0.1",
  "private": true,
  "description": "Proteus pre-alpha: verification ruler, honest Chromium scaffold, and M1A deterministic signed-config core.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "m0": "npm run m0:local",
    "m0:local": "node scripts/m0-exit-criteria.mjs",
    "m0:milestone": "node scripts/m0-exit-criteria.mjs --milestone",
    "m1a": "node scripts/m1a-exit-criteria.mjs",
    "fingerprint:fmt": "cargo fmt --manifest-path fingerprint/Cargo.toml -- --check",
    "fingerprint:test": "cargo test --manifest-path fingerprint/Cargo.toml --locked",
    "fingerprint:clippy": "cargo clippy --manifest-path fingerprint/Cargo.toml --locked --all-targets -- -D warnings",
    "verify:selftest": "node verify-lab/bin/verify-lab.mjs selftest",
    "verify:tests": "node verify-lab/test/run-tests.mjs",
    "verify:serve": "node verify-lab/bin/verify-lab.mjs serve",
    "verify:live": "node verify-lab/tools/drive-chrome.mjs",
    "engine:baseline": "node engine-chromium/scripts/baseline.mjs --check",
    "engine:build-contract": "node engine-chromium/scripts/build-contract.mjs --check",
    "engine:dependency-lock-tests": "node engine-chromium/test/dependency-lock.mjs",
    "engine:toolchain-lock-tests": "node engine-chromium/test/toolchain-lock.mjs",
    "engine:check-m0-series": "node engine-chromium/scripts/check-series.mjs --active",
    "engine:check-series": "node engine-chromium/scripts/check-series.mjs",
    "engine:bundle-tests": "node engine-chromium/test/bundle-manifest.mjs",
    "engine:license-bundle-tests": "node engine-chromium/test/artifact-licenses.mjs",
    "engine:effective-args-tests": "node engine-chromium/test/effective-gn-args.mjs",
    "engine:build-sbom-tests": "node engine-chromium/test/build-sbom.mjs",
    "engine:package-record-tests": "node engine-chromium/test/package-record.mjs",
    "engine:build-record-tests": "node engine-chromium/test/m0-build-record.mjs",
    "engine:github-actions-job-tests": "node engine-chromium/test/github-actions-job.mjs",
    "engine:artifact-staging-tests": "node engine-chromium/test/validate-artifact-staging.mjs && node engine-chromium/test/m0-artifact-transport.mjs",
    "engine:m0-scaffold-honesty": "node engine-chromium/test/scaffold-honesty.mjs --m0",
    "engine:scaffold-honesty": "node engine-chromium/test/scaffold-honesty.mjs",
    "engine:evidence-tests": "node engine-chromium/test/m0-evidence.mjs",
    "engine:evidence-v2-tests": "node engine-chromium/test/m0-evidence-v2.mjs",
    "engine:sbom": "node engine-chromium/scripts/sbom.mjs",
    "license:check": "node scripts/license-policy.mjs",
    "engine:provenance": "node engine-chromium/scripts/provenance.mjs --demo",
    "engine:track": "node engine-chromium/tracking-bot/pipeline.mjs --dry-run",
    "test": "npm run verify:selftest && npm run verify:tests && npm run engine:baseline && npm run engine:build-contract && npm run engine:dependency-lock-tests && npm run engine:toolchain-lock-tests && npm run engine:check-series && npm run engine:bundle-tests && npm run engine:license-bundle-tests && npm run engine:effective-args-tests && npm run engine:build-sbom-tests && npm run engine:package-record-tests && npm run engine:build-record-tests && npm run engine:github-actions-job-tests && npm run engine:artifact-staging-tests && npm run engine:scaffold-honesty && npm run engine:evidence-tests && npm run engine:evidence-v2-tests && npm run license:check && npm run m1a && npm run m0:local"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
