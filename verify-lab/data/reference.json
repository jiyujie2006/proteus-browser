{
  "_comment": "Reference data for coherence rules and M1A deterministic profile generation. This is the machine-readable backbone shared by the fingerprint engine and verification lab. Values are curated seed facts, not population telemetry; the full distribution-backed dataset arrives in M4.",
  "_version": "0.2.0-m1a-seed",
  "_rulesVersion": "1.0.0",

  "platformByOs": {
    "Windows": ["Win32"],
    "macOS": ["MacIntel", "MacARM"],
    "Linux": ["Linux x86_64", "Linux aarch64"],
    "ChromeOS": ["Linux x86_64", "Linux aarch64"],
    "Android": ["Linux armv8l", "Linux aarch64"],
    "iOS": ["iPhone", "iPad"]
  },

  "gpuVendorFamiliesByOs": {
    "_comment": "Which GPU vendor families are physically possible on each OS. The classic V1 tell is an Apple renderer under Win32. Apple silicon GPUs only appear on macOS/iOS; on Windows/Linux you see NVIDIA/AMD/Intel/(Qualcomm on some ARM laptops).",
    "Windows": ["NVIDIA", "AMD", "Intel", "Qualcomm", "Microsoft"],
    "macOS": ["Apple", "AMD", "Intel"],
    "Linux": ["NVIDIA", "AMD", "Intel"],
    "ChromeOS": ["Intel", "AMD", "Qualcomm", "Mali", "Adreno"],
    "Android": ["Adreno", "Mali", "PowerVR", "Xclipse"],
    "iOS": ["Apple"]
  },

  "gpuVendorStringMarkers": {
    "_comment": "Substrings used to classify a WebGL UNMASKED_RENDERER/VENDOR string into a vendor family. Matched case-insensitively.",
    "NVIDIA": ["nvidia", "geforce", "quadro", "rtx", "gtx"],
    "AMD": ["amd", "radeon", "ati "],
    "Intel": ["intel", "hd graphics", "uhd graphics", "iris"],
    "Apple": ["apple"],
    "Qualcomm": ["qualcomm", "adreno"],
    "Adreno": ["adreno"],
    "Mali": ["mali"],
    "PowerVR": ["powervr"],
    "Xclipse": ["xclipse"],
    "Microsoft": ["microsoft basic", "microsoft corporation"]
  },

  "fontsByOs": {
