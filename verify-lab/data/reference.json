      { "width": 1920, "height": 1080, "dpr": 1.0 },
      { "width": 2560, "height": 1440, "dpr": 1.0 },
      { "width": 3840, "height": 2160, "dpr": 1.0 },
      { "width": 3840, "height": 2160, "dpr": 1.5 },
      { "width": 1536, "height": 864, "dpr": 1.25 },
      { "width": 1280, "height": 720, "dpr": 1.0 }
    ],
    "laptop": [
      { "width": 1920, "height": 1080, "dpr": 1.0 },
      { "width": 1536, "height": 864, "dpr": 1.25 },
      { "width": 1366, "height": 768, "dpr": 1.0 },
      { "width": 1440, "height": 900, "dpr": 2.0 },
      { "width": 1680, "height": 1050, "dpr": 2.0 },
      { "width": 2560, "height": 1600, "dpr": 2.0 },
      { "width": 1512, "height": 982, "dpr": 2.0 }
    ]
  },

  "hardwareByClass": {
    "_comment": "Plausible (hardwareConcurrency, deviceMemory-GiB) pairs by class (rule R-HW-PAIR). deviceMemory is a coarse Chrome-reported bucket capped at 8. The tell is an implausible pair like 32 cores / 0.25 GiB.",
    "desktop": { "coresMin": 4, "coresMax": 32, "memoryValues": [4, 8], "minMemoryForCores": { "16": 8, "24": 8, "32": 8 } },
    "laptop": { "coresMin": 4, "coresMax": 16, "memoryValues": [4, 8], "minMemoryForCores": { "12": 8, "16": 8 } }
  },

  "localeByRegion": {
    "_comment": "region -> expected timezone(s) and primary Accept-Language head. Used for R-TZ-GEO and R-LANG when a proxy geo / region is known. Representative subset.",
    "US": { "timezones": ["America/New_York", "America/Chicago", "America/Denver", "America/Los_Angeles", "America/Phoenix"], "languageHead": "en-US" },
    "GB": { "timezones": ["Europe/London"], "languageHead": "en-GB" },
