  "browserFamily": {
    "_comment": "brand -> engine family, to enforce no cross-family impersonation (ADR 0002). A UA/CH combination claiming a brand from the wrong family is rejected.",
    "Chrome": "chromium",
    "Edge": "chromium",
    "Brave": "chromium",
    "Opera": "chromium",
    "Firefox": "firefox",
    "Safari": "webkit"
  },

  "liveVersionWindow": {
    "_comment": "Currently-plausible major-version window per brand (rule R-VERSION-LIVE). A version far outside the live window is a V2 rarity signal. These are seed values as of the M0 dataset snapshot and are refreshed out-of-band (tdd/05 §6); staleness is a tracked bug. NOTE: this window was corrected after the M0 live-drive harness observed the actually-installed Chrome 150 / Firefox 152 (2026-07) — the original seed lowballed the window and false-flagged current Chrome, a real demonstration of the staleness risk the dataset-refresh cadence exists to prevent.",
    "_snapshotDate": "2026-07",
    "Chrome": { "min": 144, "max": 152 },
    "Edge": { "min": 144, "max": 152 },
    "Brave": { "min": 144, "max": 152 },
    "Opera": { "min": 130, "max": 138 },
    "Firefox": { "min": 148, "max": 154 }
  },

