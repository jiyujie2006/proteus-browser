*.obj

# Fingerprint dataset bundles (signed, distributed out-of-band)
/fingerprint/datasets/*.bundle
/fingerprint/datasets/*.sig

# Local config / secrets — never commit
*.local
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
.npmrc
credentials.json
service-account*.json
secrets/

# Encrypted profile data (never leaves the machine; never in VCS)
/profiles/
*.sqlcipher

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
