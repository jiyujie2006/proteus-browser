# Build artifacts
/build/
/out/
/dist/
/target/
/fingerprint/target/
node_modules/

# verify-lab / tooling scratch
*.tmp
/verify-lab/**/out/
proteus-fingerprint.json

# Chromium / engine build trees (huge; never committed)
/engine-chromium/src/
/engine-chromium/out/
/engine-chromium/artifacts/*
!/engine-chromium/artifacts/README.md
